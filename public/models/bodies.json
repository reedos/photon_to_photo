    "glb": "public/models/dslr.glb",
    "mount": {
      "type": "Nikon F geometry",
      "flangeMm": 46.5,
      "mountFaceZ": -46.5,
      "throatMm": 44.0,
      "lugCount": 3,
      "contactCount": 8
    },
    "sensor": {
      "planeZ": 0.0,
      "activeAreaWidthMm": 35.9,
      "activeAreaHeightMm": 23.9,
      "filterStackThicknessMm": 2.0
    },
    "envelopeMm": { "width": 146.0, "height": 124.0, "depth": 78.5 },
    "mirror": { "widthMm": 36, "heightMm": 34, "restAngleDeg": 45, "hingeEdge": "top" },
    "shutter": { "type": "vertical-travel two-curtain focal-plane", "travelDistanceMm": 24 },
    "namedComponents": [
      "body", "grip", "mount", "mountLugs", "contacts", "mirror", "subMirror", "focusingScreen",
      "prism", "prismHousing", "shutter", "shutterCurtainFront", "shutterCurtainRear",
      "sensorPackage", "sensorDie", "pixelArray", "filterStack", "bondWires", "rearScreen",
